          }
        }
      }
    },
    "Sets every Image Adjustment slider back to neutral, the same as Reset All in the menu." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "将所有图像调整滑块恢复为中性值，与菜单中的“全部重置”相同。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "將所有影像調整滑桿恢復為中性值，與選單中的「全部重置」相同。"
          }
        }
      }
    },
    "Sets one Image Adjustment slider, the same as moving it in the menu. Most run from -100 to 100 with 0 as neutral; Quantization runs from 2 to 256." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "设置一个图像调整滑块，与在菜单中拖动它相同。大多数的范围为 -100 到 100，0 为中性值；量化的范围为 2 到 256。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "設定一個影像調整滑桿，與在選單中拖移它相同。大多數的範圍為 -100 到 100，0 為中性值；量化的範圍為 2 到 256。"
          }
        }
      }
    },
